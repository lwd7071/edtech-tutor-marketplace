# Local development: Next.js runs on :3000 and Spring Boot runs on :8080.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-side public fetch target (required on Vercel production)
BACKEND_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
APP_INTERNAL_REVALIDATE_SECRET=replace-with-the-same-server-secret-as-backend
