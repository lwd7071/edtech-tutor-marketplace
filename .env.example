# --- Database Configuration (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5433/edtech_db
DB_USERNAME=edtech_user
DB_PASSWORD=replace-with-a-long-random-url-safe-password
EDTECH_POSTGRES_ADMIN_PASSWORD=replace-with-a-different-long-random-admin-password
EDTECH_POSTGRES_PORT=5433
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=1
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_IDLE_TIMEOUT_MS=300000
DB_POOL_MAX_LIFETIME_MS=1500000

# --- Redis Configuration ---
REDIS_URL=redis://localhost:6379

# --- Mail ---
APP_EMAIL_PROVIDER=logging
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tutor Match

# --- Spring Active Profiles (local / cloud) ---
SPRING_PROFILES_ACTIVE=local

# --- Application Security & JWT ---
APP_SCHEDULING_ENABLED=true
APP_JWT_SECRET=your-256-bit-secret-key-change-this-in-production-environments-min-32-chars
EDTECH_ACCOUNT_ENCRYPTION_KEY=change-this-32-character-key-now
# Add the public HTTPS hostname here when using Cloudflare Tunnel.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:8081,http://127.0.0.1:8081
APP_OAUTH2_FRONTEND_CALLBACK_URI=http://localhost:8081/oauth2/callback
APP_FRONTEND_URL=http://localhost:8081
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
EDTECH_NGINX_PORT=8081

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# --- payOS Payment Gateway ---
APP_PAYMENT_PROVIDER=disabled
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_CONNECT_TIMEOUT=3s
PAYOS_READ_TIMEOUT=10s

# --- Cloudinary Storage ---
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
