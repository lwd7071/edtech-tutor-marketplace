# --- Database Configuration (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/edtech_db
DB_USERNAME=edtech_user
DB_PASSWORD=edtech_password

# --- Redis Configuration ---
REDIS_URL=redis://localhost:6379

# --- Mail ---
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=2525
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- Spring Active Profiles (local / cloud) ---
SPRING_PROFILES_ACTIVE=local

# --- Application Security & JWT ---
APP_JWT_SECRET=your-256-bit-secret-key-change-this-in-production-environments-min-32-chars
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- payOS Payment Gateway ---
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# --- Cloudinary Storage ---
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
